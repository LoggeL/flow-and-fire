{
  "name": "@faf/headless",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "goldens": "node --import tsx scripts/goldens.ts",
    "build:wasm": "wat2wasm src/spk5/xxh32.wat -o src/spk5/xxh32.wasm",
    "build:harness": "vite build -c vite.harness.config.ts",
    "test:xengine": "node --import tsx scripts/xengine.ts",
    "bench": "node --import tsx scripts/bench.ts",
    "spk2": "node --import tsx scripts/spk2.ts",
    "spk3": "node --expose-gc --import tsx scripts/spk3.ts",
    "ms3": "node --expose-gc --import tsx scripts/ms3.ts"
  },
  "dependencies": {
    "@faf/blueprints": "workspace:*",
    "@faf/fixed": "workspace:*",
    "@faf/formats": "workspace:*",
    "@faf/heap": "workspace:*",
    "@faf/nav": "workspace:*",
    "@faf/protocol": "workspace:*",
    "@faf/rules": "workspace:*",
    "@faf/sim": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.1",
    "wabt": "^1.0.39"
  }
}
