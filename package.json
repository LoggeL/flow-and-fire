{
  "name": "flow-and-fire",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @faf/game dev",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0 && depcruise --config .dependency-cruiser.cjs packages apps tools",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:xengine": "pnpm -r --workspace-concurrency=1 --if-present run test:xengine",
    "bench": "pnpm -r --workspace-concurrency=1 --if-present run bench",
    "ci:local": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:xengine && pnpm test:e2e && pnpm smoke:fx -- --browsers=chromium && pnpm bench && pnpm --filter @faf/assets-pipeline run check && pnpm bench:spk4 -- --quick",
    "maps": "pnpm --filter @faf/formats run maps",
    "assets": "pnpm --filter @faf/assets-pipeline run build",
    "bench:spk4": "pnpm --filter @faf/render-bench run spk4",
    "sfx": "pnpm --filter @faf/sfx run sfx",
    "sfx:analyze": "pnpm --filter @faf/sfx run analyze",
    "sfx:audit": "pnpm --filter @faf/sfx run audit",
    "sfx:preview": "pnpm --filter @faf/sfx run preview",
    "models": "tsx packages/modelkit/scripts/models.ts",
    "models:shots": "pnpm --filter @faf/model-shots run shots",
    "models:viewer": "pnpm --filter @faf/model-viewer dev",
    "fx:lab": "pnpm --filter @faf/fx-lab dev",
    "smoke:fx": "pnpm --filter @faf/render-fx run smoke",
    "bench:fx": "pnpm --filter @faf/fx-lab run fxbench",
    "test:e2e:fx": "pnpm --filter @faf/fx-lab run build && playwright test -c apps/fx-lab/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faf/eslint-plugin-sim": "workspace:*",
    "@faf/modelkit": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wabt": "^1.0.39"
  }
}
