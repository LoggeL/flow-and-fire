{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tests.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/bench/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/test/**/*.tsx",
    "apps/*/scripts/**/*.ts",
    "apps/*/vite.config.ts",
    "apps/*/playwright.config.ts",
    "packages/*/vite.config.ts",
    "tools/*/test/**/*.ts",
    "tools/*/scripts/**/*.ts",
    "tools/*/bench/**/*.ts",
    "tools/*/vite.config.ts",
    "tools/*/vite.*.config.ts",
    "test/**/*.ts",
    "content/models/**/*.ts",
    "content/icons/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
