# dependencies / caches
.worktrees/
node_modules/
.turbo/
.vite/
.cache/
*.tsbuildinfo

# build output
dist/
**/dist/**
tools/render-bench/dist/
tools/headless/dist-harness/
content/generated/
# Audio: Opus/WebM + Manifest werden eingecheckt (≈ 3 MB, Spiel/Vorschau ohne ffmpeg nutzbar);
# WAVs (≈ 60 MB) und der Build-Cache entstehen lokal mit `pnpm sfx`. Siehe docs/design/audio.md §7.
!content/audio/dist/
!content/audio/dist/**/
!content/audio/dist/**/*.webm
!content/audio/dist/manifest.json
!content/audio/dist/manifest.js

# test / bench output
coverage/
test-results/
playwright-report/
blob-report/
bench-results/
**/results/*.tmp.json
# measurement output of bench / test:xengine (dated JSON, local evidence; docs via --update-docs)
tools/headless/results/*.json
packages/*/bench/results/*.json
tools/render-bench/results/*.json
# MS3: nav SPK3 bench, headless SPK2/SPK3/MS3 benches
packages/nav/bench/results/
tools/headless/results/
tools/headless/spk2/out/
*.bench.tmp.*
*.cpuprofile
*.heapsnapshot

# misc
*.log
.DS_Store
.env
.env.*

apps/*/results/*.json

